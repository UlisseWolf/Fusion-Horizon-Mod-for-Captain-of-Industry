<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Options.user" Condition="Exists('Options.user')" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>FusionHorizon</RootNamespace>
    <!-- Forced to "Fusion_Horizon" (matching the original CustomAssets/Python mod's id) so
         that saves created with the old mod keep recognizing this DLL port as the same mod.
         This also drives $(TargetName) -> the built DLL becomes Fusion_Horizon.dll and the
         deployed Mods folder becomes .../Mods/Fusion_Horizon/, matching manifest.json's "id"
         (the modding docs require the mod folder name to match the manifest "id" field). -->
    <AssemblyName>Fusion_Horizon</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Deploy to %APPDATA%\Captain of Industry\Mods\<TargetName>\ after every build. This is
         the same mechanism ExampleMod.csproj (from the official modding repo) and
         CoI.MetallurgyPlus use — confirmed working. Set to false if you want to deploy
         manually instead. -->
    <DeployToModsFolder>true</DeployToModsFolder>
    <COI_MODS Condition="'$(COI_MODS)' == ''">$(APPDATA)\Captain of Industry\Mods</COI_MODS>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Options.user" Condition="Exists('Options.user')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Source\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- PNG icons are plain Content, like Metallurgy+ does for its custom icons. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Translations\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Thumbnail.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Thumbnail.png')" />
  </ItemGroup>

  <!-- AssetBundles built from the Unity companion project (see README_CONVERSIONE.md), if any
       have been built yet. Collected as their own item group (not plain <Content>) because
       DeployToModsFolder below copies them to a dedicated AssetBundles subfolder, same as
       ExampleMod.csproj/Metallurgy+ do. -->
  <ItemGroup Condition="Exists('AssetBundles')">
    <AssetBundles Include="AssetBundles\**\*" Exclude="**\AssetBundles;**\AssetBundles.manifest" />
  </ItemGroup>

  <ItemGroup>
    <GameAssembly Include="Mafi" />
    <GameAssembly Include="Mafi.Core" />
    <GameAssembly Include="Mafi.Base" />
  </ItemGroup>

  <!-- Scaffolding for referencing game data/DLLs. -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(COI_ROOT)</GameDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GameDir)\Captain of Industry_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="@(GameAssembly)">
      <HintPath Condition="Exists('$(GameManagedDir)\%(Identity).dll')">$(GameManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_InvalidGameDir Condition="!Exists('$(GameManagedDir)')">true</_InvalidGameDir>
    </PropertyGroup>
    <Error Text="No valid Captain of Industry installation directory set. Set the COI_ROOT environment variable, or create an Options.user file overriding GameDir, pointing to your game install." ContinueOnError="false" Condition="'$(_InvalidGameDir)' == 'true'" />
  </Target>

  <!-- Copies the built mod to %APPDATA%\Captain of Industry\Mods\<TargetName>\ — this is the
       step that was MISSING/misconfigured before and is why the mod never showed up in game.
       Unlike a previous revision of this file, this target has NO extra opt-in flag: it always
       runs after a successful build (for both Debug and Release), exactly like the official
       ExampleMod.csproj's own "DeployToModsFolder" target. -->
  <Target Name="DeployToModsFolder" AfterTargets="PostBuildEvent" Condition="'$(DeployToModsFolder)' == 'true' AND '$(ProjectDir)' != '*Undefined*'">
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="$(COI_MODS)\$(TargetName)\" />
    <Copy SourceFiles="$(ProjectDir)Thumbnail.png" DestinationFolder="$(COI_MODS)\$(TargetName)\" Condition="Exists('$(ProjectDir)Thumbnail.png')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(COI_MODS)\$(TargetName)\" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(COI_MODS)\$(TargetName)\" Condition="'$(Configuration)' == 'Debug' AND Exists('$(TargetDir)$(TargetName).pdb')" />
    <ItemGroup>
      <_DeployedAssets Include="$(ProjectDir)Assets\**\*" />
      <_DeployedAssetsDest Include="@(_DeployedAssets->Replace('$(ProjectDir)Assets\', '$(COI_MODS)\$(TargetName)\Assets\'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployedAssets)" DestinationFiles="@(_DeployedAssetsDest)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)Assets')" />
    <ItemGroup>
      <_DeployedTranslations Include="$(ProjectDir)Translations\**\*" />
      <_DeployedTranslationsDest Include="@(_DeployedTranslations->Replace('$(ProjectDir)Translations\', '$(COI_MODS)\$(TargetName)\Translations\'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_DeployedTranslations)" DestinationFiles="@(_DeployedTranslationsDest)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)Translations')" />
    <Copy SourceFiles="@(AssetBundles)" DestinationFolder="$(COI_MODS)\$(TargetName)\AssetBundles" Condition="'@(AssetBundles)' != ''" />
    <Message Text="[FusionHorizon] Deployed to $(COI_MODS)\$(TargetName)\" Importance="high" />
  </Target>
</Project>
